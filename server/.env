# LITERATURE_PUSH_MODE=profile：按用户“文献推送开关”执行（默认）
# LITERATURE_PUSH_MODE=rule：全局强制按规则推送
# LITERATURE_PUSH_MODE=random：全局强制不定时推送
# LITERATURE_PUSH_DEFAULT=true/false：当用户未设置该开关时的默认行
# Literature push mode: profile | rule | random
