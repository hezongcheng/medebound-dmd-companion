# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=dmd_companion

# 服务器配置
SERVER_PORT=3001

# JWT密钥 (生产环境请使用更复杂的密钥)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Gemini API密钥
GEMINI_API_KEY=your-gemini-api-key

# 微信公众号配置
WECHAT_APP_ID=wx2992995aa7343e48
WECHAT_APP_SECRET=your-wechat-app-secret
WECHAT_REDIRECT_URI=http://your-domain.com/wechat/callback

# 有道翻译API配置
YOUDAO_APP_KEY=your-youdao-app-key
YOUDAO_APP_SECRET=your-youdao-app-secret

# PubMed E-utilities request identity (production recommended)
PUBMED_TOOL=dmd_companion
PUBMED_EMAIL=admin@example.com
# Optional; configure an NCBI API key when request volume is high
# PUBMED_API_KEY=your-ncbi-api-key
# PUBMED_USER_AGENT=DMD-Companion/1.0 (admin@example.com)
# Merge concurrent fetches and suppress repeated automatic refreshes for 10 minutes
PUBMED_FETCH_COOLDOWN_MS=600000

# Literature metadata source: auto | pubmed | europe_pmc
# Use europe_pmc while the server IP is blocked by NCBI.
LITERATURE_FETCH_SOURCE=auto
# EUROPE_PMC_USER_AGENT=DMD-Companion/1.0

# Literature push config
# LITERATURE_PUSH_MODE: profile | rule | random
LITERATURE_PUSH_MODE=profile
# Default when user switch is unset: true=rule, false=random
LITERATURE_PUSH_DEFAULT=true

